{"name": "WF-MKT-07: Carrito Abandonado Multicanal V10", "nodes": [{"parameters": {}, "id": "trigger-cart-abandon", "name": "Cart Abandon Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 1, "position": [250, 300], "webhookId": "cart-abandon-v10", "path": "cart-abandon-v10", "responseMode": "responseNode", "options": {}}, {"parameters": {"jsCode": "const item = $input.first().json;\nreturn {\n  customer_id: item.body.customer_id,\n  email: item.body.email,\n  cart_value: item.body.cart_value || 0,\n  products: item.body.products || [],\n  session_id: item.body.session_id,\n  timestamp: new Date().toISOString(),\n  days_since_last_purchase: item.body.days_since_last_purchase || 999\n};"}, "id": "parse-payload", "name": "Parse Payload", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [450, 300]}, {"parameters": {"jsCode": "const customer = $input.first().json;\nconst cartValue = customer.cart_value || 0;\nconst days = customer.days_since_last_purchase;\n\nlet segment = 'standard';\nif (cartValue > 500 && days < 30) segment = 'VIP';\nelse if (days > 180 && cartValue < 50) segment = 'at-risk';\n\nreturn {\n  ...customer,\n  segment,\n  cltv: cartValue * 3,\n  recovery_probability: segment === 'VIP' ? 0.45 : segment === 'at-risk' ? 0.12 : 0.28\n};"}, "id": "ai-segmentation", "name": "AI Segmentation & CLTV", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [650, 300]}, {"parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "cond-vip", "leftValue": "={{ $json.segment }}", "rightValue": "VIP", "operator": {"type": "string", "operation": "equals"}}]}}, "id": "router-segment", "name": "Router: Segment", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [850, 300]}, {"parameters": {"amount": 1, "unit": "hours"}, "id": "delay-1h", "name": "Wait 1h", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [1050, 150]}, {"parameters": {"conditions": {"op