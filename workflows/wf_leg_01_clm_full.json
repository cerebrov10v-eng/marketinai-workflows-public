{"name": "WF-LEG-01: CLM Full Workflow V10", "nodes": [{"parameters": {}, "id": "email-trigger-contract", "name": "Email: Contract Received", "type": "n8n-nodes-base.emailReadImap", "typeVersion": 2, "position": [250, 300], "credentials": {"imap": {"id": "imap-v10", "name": "V10 IMAP"}}, "options": {"attachment": true, "customEmailConfig": {"searchCriteria": ["UNSEEN", ["SUBJECT", "contrato"]]}}}, {"parameters": {"jsCode": "const email = $input.first().json;\nconst attachments = email.attachments || [];\nconst pdf = attachments.find(a => a.filename?.endsWith('.pdf'));\nreturn {\n  from: email.from,\n  subject: email.subject,\n  contract_pdf: pdf?.content,\n  contract_pdf_url: pdf?.contentUrl,\n  received_at: email.date,\n  sender_company: email.from?.split('@')[1]\n};"}, "id": "parse-contract-email", "name": "Parse Contract Email", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [450, 300]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/ai/extract-contract", "sendBody": true, "contentType": "json", "body": {"pdf_url": "={{ $json.contract_pdf_url }}", "fields": ["parties", "object", "price", "payment_terms", "duration", "renewal", "penalties", "governing_law", "termination_causes"]}, "options": {}}, "id": "ai-extract", "name": "AI Contract Extraction", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [650, 300]}, {"parameters": {"method": "GET", "url": "={{ $env.V10V_API_URL }}/api/legal/precedents?type={{ $json.object_type }}", "options": {}}, "id": "fetch-precedents", "name": "Fetch Precedents (KG)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [850, 300]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/legal/risk-score", "sendBody": true, "contentType": "json", "body": {"extracted": "={{ JSON.stringify($input.all()[0].json) }}", "precedents": "={{ JSON.stringify($input.all()[1].json) }}"}, "options": {}}, "id": "ai-risk-score", "name": "AI Risk Score", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1050, 300]}, {"parameters": {"jsCode": "const risk = $input.first().json;\nlet approval_tier = 'junior';\nif (risk.score > 70) approval_tier = 'senior';\nif (risk.score > 85) approval_tier = 'partner';\nif (risk.clauses?.some(c => c.type === 'penalty' && c.amount > 50000)) approval_tier = 'partner';\n\nreturn {\n  ...risk,\n  approval_tier,\n  auto_approved: risk.score < 30,\n  requires_esignature: true\n};"}, "id": "approval-workflow", "name": "Approval Workflow", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1250, 300]}, {"parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "cond-auto", "leftValue": "={{ $json.auto_approved }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equals"}}]}}, "id": "router-approval", "name": "Router: Auto vs Human", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1450, 300]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/docusign/send", "sendBody": true, "contentType": "json", "body": {"template_id": "contract_approval_auto", "recipient_email": "={{ $json.from }}", "contract_id": "={{ $json.contract_id }}", "risk_score": "={{ $json.score }}", "message": "Contrato aprobado autom\u00c3\u00a1ticamente. Riesgo bajo ({{ $json.score }}/100). Firmar para ejecutar."}, "options": {}}, "id": "send-esignature", "name": "Send eSignature", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1650, 150]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/slack/alerts", "sendBody": true, "contentType": "json", "body": {"channel": "#legal-approval", "message": "\u00f0\u0178\u201c\u2039 CONTRATO REQUIERE APROBACI\u00c3\u201cN {{ $json.approval_tier?.toUpperCase() }}\nEmpresa: {{ $json.sender_company }}\nRiesgo: {{ $json.score }}/100\nClausulas cr\u00c3\u00adticas: {{ $json.critical_clauses?.length || 0 }}\n\nRevisar: [LINK]"}, "options": {}}, "id": "slack-legal", "name": "Slack: Legal Alert", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1650, 450]}, {"parameters": {"amount": 1, "unit": "weeks"}, "id": "wait-signature", "name": "Wait: Signature", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [1850, 150]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/crm/contracts", "sendBody": true, "contentType": "json", "body": {"contract_id": "={{ $json.contract_id }}", "status": "signed", "signed_at": "={{ new Date().toISOString() }}", "extracted_data": "={{ JSON.stringify($json.extracted) }}", "risk_score": "={{ $json.score }}", "auto_approved": "={{ $json.auto_approved }}"}, "options": {}}, "id": "crm-contract", "name": "CRM: Register Contract", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [2050, 150]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/calendar/reminders", "sendBody": true, "contentType": "json", "body": {"contract_id": "={{ $json.contract_id }}", "renewal_date": "={{ $json.renewal_date }}", "alerts": ["90_days_before", "30_days_before", "7_days_before"]}, "options": {}}, "id": "reminder-renewal", "name": "Set Renewal Reminders", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [2250, 150]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/audit/log", "sendBody": true, "contentType": "json", "body": {"entity_type": "contract", "entity_id": "={{ $json.contract_id }}", "action": "workflow_completed", "user": "system", "metadata": {"risk_score": "={{ $json.score }}", "auto_approved": "={{ $json.auto_approved }}", "approval_tier": "={{ $json.approval_tier }}"}}, "options": {}}, "id": "audit-log", "name": "Audit Log", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [2450, 150]}], "connections": {"Email: Contract Received": {"main": [[{"node": "Parse Contract Email", "type": "main", "index": 0}]]}, "Parse Contract Email": {"main": [[{"node": "AI Contract Extraction", "type": "main", "index": 0}]]}, "AI Contract Extraction": {"main": [[{"node": "Fetch Precedents (KG)", "type": "main", "index": 0}]]}, "Fetch Precedents (KG)": {"main": [[{"node": "AI Risk Score", "type": "main", "index": 0}]]}, "AI Risk Score": {"main": [[{"node": "Approval Workflow", "type": "main", "index": 0}]]}, "Approval Workflow": {"main": [[{"node": "Router: Auto vs Human", "type": "main", "index": 0}]]}, "Router: Auto vs Human": {"main": [[{"node": "Send eSignature", "type": "main", "index": 0}], [{"node": "Slack: Legal Alert", "type": "main", "index": 0}]]}, "Send eSignature": {"main": [[{"node": "Wait: Signature", "type": "main", "index": 0}]]}, "Wait: Signature": {"main": [[{"node": "CRM: Register Contract", "type": "main", "index": 0}]]}, "CRM: Register Contract": {"main": [[{"node": "Set Renewal Reminders", "type": "main", "index": 0}]]}, "Set Renewal Reminders": {"main": [[{"node": "Audit Log", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1"}, "staticData": null, "tags": [{"name": "v10v-certified", "color": "#d4af37"}, {"name": "legal", "color": "#6c5ce7"}, {"name": "LEG-01", "color": "#4ecdc4"}], "meta": {"roi_data": {"roi_percentage": "324.5%", "dollar_return": "$4.24/$1 invertido", "cycle_reduction": "15 a 7 d\u00c3\u00adas promedio", "time_saved": "60% menos tiempo en gesti\u00c3\u00b3n contractual"}, "differentiator": "Extracci\u00c3\u00b3n AI de contratos + Knowledge Graph de precedentes + Risk Score autom\u00c3\u00a1tico + eSignature integrado. Ciclo completo sin intervenci\u00c3\u00b3n humana para contratos de riesgo bajo.", "complexity_score": 9.0, "estimated_build_time_hours": 10, "price_target": "\u00e2\u201a\u00ac397-597 setup + \u00e2\u201a\u00ac149-249/mes retainer", "requires_integrations": ["Email IMAP", "DocuSign/PandaDoc", "CRM", "Knowledge Graph", "Slack"], "status": "ready-for-deploy"}}
