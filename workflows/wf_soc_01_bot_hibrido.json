{"name": "WF-SOC-01: Bot-Agente Hibrido Multicanal V10", "nodes": [{"parameters": {}, "id": "webhook-multichannel", "name": "Multichannel Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 1, "position": [250, 300], "webhookId": "multichannel-inbox-v10", "path": "multichannel-inbox-v10", "responseMode": "responseNode", "options": {}}, {"parameters": {"jsCode": "const msg = $input.first().json.body;\nconst channelMap = {\n  'instagram_dm': 'instagram',\n  'whatsapp_business': 'whatsapp',\n  'web_chat': 'web',\n  'facebook_messenger': 'facebook',\n  'telegram_bot': 'telegram'\n};\nreturn {\n  message_id: msg.message_id,\n  channel: channelMap[msg.channel] || msg.channel,\n  sender_id: msg.sender_id,\n  sender_name: msg.sender_name,\n  text: msg.text,\n  timestamp: msg.timestamp,\n  media_url: msg.media_url,\n  thread_id: msg.thread_id\n};"}, "id": "parse-inbound", "name": "Parse Inbound Message", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [450, 300]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/ai/classify-intent", "sendBody": true, "contentType": "json", "body": {"text": "={{ $json.text }}", "channel": "={{ $json.channel }}"}, "options": {}}, "id": "ai-intent", "name": "AI Intent Classification", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [650, 300]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/kb/query", "sendBody": true, "contentType": "json", "body": {"query": "={{ $json.text }}", "intent": "={{ $json.intent }}", "channel": "={{ $json.channel }}"}, "options": {}}, "id": "rag-query", "name": "RAG: KB Query", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [850, 300]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/ai/generate-response", "sendBody": true, "contentType": "json", "body": {"context": "={{ JSON.stringify($input.all()[1].json) }}", "intent": "={{ $json.intent }}", "tone": "={{ $json.channel === 'whatsapp' ? 'casual' : 'professional' }}", "brand_voice": "directo, tecnico pero humano, protector", "language": "={{ $json.channel === 'instagram' ? 'es-AR' : 'es-ES' }}"}, "options": {}}, "id": "ai-generate", "name": "AI Generate Response", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1050, 300]}, {"parameters": {"jsCode": "const generated = $input.first().json;\nconst confidence = generated.confidence || 0.7;\nconst intent = generated.intent;\n\nlet resolved = false;\nif (confidence > 0.85 && !generated.needs_human) resolved = true;\nif (intent === 'complaint' && confidence < 0.9) resolved = false;\nif (intent === 'pricing' && generated.has_objection) resolved = false;\n\nreturn {\n  ...generated,\n  resolved,\n  confidence,\n  sentiment: generated.sentiment || 'neutral',\n  escalation_reason: resolved ? null : (generated.escalation_reason || 'low_confidence')\n};"}, "id": "resolution-check", "name": "Resolution Check", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1250, 300]}, {"parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "cond-resolved", "leftValue": "={{ $json.resolved }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equals"}}]}}, "id": "router-resolution", "name": "Router: Resolved?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1450, 300]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/outbound/send", "sendBody": true, "contentType": "json", "body": {"channel": "={{ $json.channel }}", "recipient_id": "={{ $json.sender_id }}", "message": "={{ $json.response_text }}", "thread_id": "={{ $json.thread_id }}"}, "options": {}}, "id": "send-auto", "name": "Send Auto Response", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1650, 150]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/slack/handoff", "sendBody": true, "contentType": "json", "body": {"channel": "#support-escalation", "message": "\u00f0\u0178\u00a4\u2013\u00e2\u2020\u2019\u00f0\u0178\u2018\u00a4 HANDOFF\nCanal: {{ $json.channel }}\nCliente: {{ $json.sender_name }}\nIntent: {{ $json.intent }}\nConfianza: {{ $json.confidence }}\nSentimiento: {{ $json.sentiment }}\n\nHistorial:\n{{ $json.text }}\n\nTomar: [LINK]"}, "options": {}}, "id": "slack-handoff", "name": "Slack: Human Handoff", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1650, 450]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/outbound/send", "sendBody": true, "contentType": "json", "body": {"channel": "={{ $json.channel }}", "recipient_id": "={{ $json.sender_id }}", "message": "Entiendo tu consulta. Te estoy transfiriendo con un especialista que te va a ayudar mejor. Un momento por favor.", "thread_id": "={{ $json.thread_id }}"}, "options": {}}, "id": "send-handoff-msg", "name": "Send Handoff Message", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1850, 450]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/crm/tickets", "sendBody": true, "contentType": "json", "body": {"customer_id": "={{ $json.sender_id }}", "channel": "={{ $json.channel }}", "intent": "={{ $json.intent }}", "sentiment": "={{ $json.sentiment }}", "original_message": "={{ $json.text }}", "ai_response": "={{ $json.response_text }}", "resolved_by_ai": "={{ $json.resolved }}", "escalation_reason": "={{ $json.escalation_reason }}"}, "options": {}}, "id": "crm-ticket", "name": "CRM: Create Ticket", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [2050, 300]}, {"parameters": {"method": "POST", "url": "={{ $env.V10V_API_URL }}/api/analytics/sentiment", "sendBody": true, "contentType": "json", "body": {"ticket_id": "={{ $json.ticket_id }}", "channel": "={{ $json.channel }}", "sentiment": "={{ $json.sentiment }}", "confidence": "={{ $json.confidence }}", "resolution_time_seconds": "={{ $json.resolved ? 45 : null }}", "timestamp": "={{ new Date().toISOString() }}"}, "options": {}}, "id": "sentiment-track", "name": "Sentiment Tracking", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [2250, 300]}], "connections": {"Multichannel Webhook": {"main": [[{"node": "Parse Inbound Message", "type": "main", "index": 0}]]}, "Parse Inbound Message": {"main": [[{"node": "AI Intent Classification", "type": "main", "index": 0}]]}, "AI Intent Classification": {"main": [[{"node": "RAG: KB Query", "type": "main", "index": 0}]]}, "RAG: KB Query": {"main": [[{"node": "AI Generate Response", "type": "main", "index": 0}]]}, "AI Generate Response": {"main": [[{"node": "Resolution Check", "type": "main", "index": 0}]]}, "Resolution Check": {"main": [[{"node": "Router: Resolved?", "type": "main", "index": 0}]]}, "Router: Resolved?": {"main": [[{"node": "Send Auto Response", "type": "main", "index": 0}], [{"node": "Slack: Human Handoff", "type": "main", "index": 0}]]}, "Slack: Human Handoff": {"main": [[{"node": "Send Handoff Message", "type": "main", "index": 0}]]}, "Send Auto Response": {"main": [[{"node": "CRM: Create Ticket", "type": "main", "index": 0}]]}, "Send Handoff Message": {"main": [[{"node": "CRM: Create Ticket", "type": "main", "index": 0}]]}, "CRM: Create Ticket": {"main": [[{"node": "Sentiment Tracking", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1"}, "staticData": null, "tags": [{"name": "v10v-certified", "color": "#d4af37"}, {"name": "social", "color": "#ff6b6b"}, {"name": "SOC-01", "color": "#4ecdc4"}], "meta": {"roi_data": {"tickets_resolved_auto": "40% sin humano", "support_cost_reduction": "30% ahorro en soporte", "response_time": "45 segundos promedio (vs 4h humano)", "customer_satisfaction": "+12% NPS con respuestas instant\u00c3\u00a1neas", "estimated_roi": "400-600% en 12 meses"}, "differentiator": "Multicanal real (IG+WhatsApp+Web+FB+Telegram) con RAG unificado. Voz de marca consistente por canal. Escalaci\u00c3\u00b3n 