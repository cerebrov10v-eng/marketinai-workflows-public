              "name": "Authorization",
              "value": "Bearer {{ $env.V10V_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "pdf_base64",
              "value": "={{ Buffer.from($binary.pdf_binary.data, 'base64').toString('base64') }}"
            },
            {
              "name": "contract_type",
              "value": "={{ $json.contract_type || 'servicios' }}"
            },
            {
              "name": "client_id",
              "value": "={{ $json.client_id }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "3a2b3c4d-leg02-003",
      "name": "AI/ML — Extract Clauses (V10V API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [640, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.V10V_API_URL }}/api/wf-leg-02/baseline-check",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "client_id",
              "value": "={{ $json.client_id }}"
            },
            {
              "name": "contract_type",
              "value": "={{ $json.contract_type || 'servicios' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "4a2b3c4d-leg02-004",
      "name": "DATA — Baseline Check (histórico cliente)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [640, 480]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": "gpt-4o",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Eres un abogado senior especializado en revisión de contratos comerciales. Tu tarea es analizar las cláusulas extraídas de un contrato y generar un informe de riesgo detallado.\n\nPLANTILLA DE CONTRATO SEGURA (cláusulas mínimas requeridas):\n- Objeto del contrato: claro y delimitado\n- Precio y forma de pago: especificado en €, plazos definidos\n- Duración y terminación: plazo inicial + preaviso mínimo 30 días\n- Penalizaciones: proporcionales, máximo 20% del contrato\n- Responsabilidad limitada: cláusula de limitación a importe contratado\n- Protección datos (GDPR): rol responsable/encargado definido\n- Jurisdicción: tribunales españoles, ley española\n- Confidencialidad: 2-5 años post-contrato\n- Propiedad intelectual: titularidad clara\n\nCLASIFICACIÓN DE RIESGO:\n- BAJO: todas las cláusulas mínimas presentes, sin desviaciones materiales\n- MEDIO: 1-3 cláusulas ausentes o con desviaciones menores\n- ALTO: 4+ cláusulas ausentes, cláusulas abusivas, o exposición legal significativa\n- CRÍTICO: cláusulas nulas por ley, penalizaciones desproporcionadas, o ausencia de GDPR\n\nResponde SIEMPRE en JSON con este schema exacto."
            },
            {
              "role": "user",
              "content": "=CLÁUSULAS EXTRAÍDAS DEL CONTRATO:\n{{ JSON.stringify($('AI/ML — Extract Clauses (V10V API)').item.json.clauses, null, 2) }}\n\nTIPO DE CONTRATO: {{ $('AI/ML — Extract Clauses (V10V API)').item.json.contract_type }}\n\nHISTÓRICO DEL CLIENTE:\n{{ JSON.stringify($('DATA — Baseline Check (histórico cliente)').item.json, null, 2) }}\n\nGenera el informe de riesgo completo en JSON con el siguiente schema:\n{\n  \"risk_level\": \"BAJO|MEDIO|ALTO|CRÍTICO\",\n  \"risk_score\": 0-100,\n  \"summary\": \"string (2-3 líneas)\",\n  \"clauses_found\": [{ \"name\": \"string\", \"status\": \"OK|MISSING|DEFICIENT|ABUSIVE\", \"text\": \"string\", \"comment\": \"string\" }],\n  \"missing_clauses\": [\"string\"],\n  \"red_flags\": [\"string\"],\n  \"recommended_actions\": [{ \"priority\": \"URGENT|HIGH|MEDIUM\", \"action\": \"string\", \"clause\": \"string\" }],\n  \"auto_sign_eligible\": boolean,\n  \"review_time_minutes\": 4,\n  \"baseline_comparison\": { \"previous_contracts\": number, \"average_risk\": \"string\", \"trend\": \"string\" }\n}"
            }
          ]
        },
        "options": {
          "maxTokens": 4000,
          "temperature": 0.1
        }
      },
      "id": "5a2b3c4d-leg02-005",
      "name": "AI/ML — Risk Analysis GPT-4o",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [840, 380]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.message?.content || '{}';\nlet report;\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  report = JSON.parse(match ? match[0] : raw);\n} catch(e) {\n  report = { risk_level: 'ERROR', risk_score: -1, summary: 'Error parsing AI response', error: raw };\n}\n\n// Enrich with metadata\nreport.workflow_id = 'WF-LEG-02';\nreport.version = 'V10V-2026';\nreport.processed_at = new Date().toISOString();\nreport.client_id = $('TRIGGER — Webhook PDF Upload').first().json.client_id;\nreport.contract_type = $('AI/ML — Extract Clauses (V10V API)').first().json.contract_type;\nreport.pages_analyzed = $('AI/ML — Extract Clauses (V10V API)').first().json.pages || 0;\nreport.clauses_analyzed = ($('AI/ML — Extract Clauses (V10V API)').first().json.clauses || []).length;\n\n// Routing decision\nreport.route = report.risk_level === 'BAJO' && report.auto_sign_eligible ? 'AUTO_SIGN' : \n               report.risk_level === 'CRÍTICO' ? 'URGENT_REVIEW' : 'STANDARD_REVIEW';\n\nreturn [{ json: report }];"
      },
      "id": "6a2b3c4d-leg02-006",
      "name": "LOGIC — Parse & Route Risk Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "route-auto-sign",
              "leftValue": "={{ $json.route }}",
              "rightValue": "AUTO_SIGN",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "combineConditions": "all"
      },
      "id": "7a2b3c4d-leg02-007",
      "name": "LOGIC — Route: Auto-sign?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1240, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.V10V_API_URL }}/api/wf-leg-02/auto-sign",
        "sendBody": true,
        "bodyParameters": {
