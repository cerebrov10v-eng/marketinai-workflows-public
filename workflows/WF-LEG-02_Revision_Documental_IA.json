          ]
        }
      },
      "id": "8a2b3c4d-leg02-008",
      "name": "ACTION — Auto-sign via DocuSign/PandaDoc",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1440, 200]
